# Neon PostgreSQL connection string.
# Get this from your Neon project dashboard (Connection Details).
# Use the "pooled" connection string for the app; Prisma migrations
# should use the direct (non-pooled) connection — see Neon's Prisma guide.
# Read by prisma.config.ts (Prisma ORM 7 moved connection URLs for the
# CLI out of schema.prisma) and by src/lib/prisma.ts for the app itself.
DATABASE_URL="postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/mwoms?sslmode=require"

# Long random string used to sign session cookies. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string"

NODE_ENV=development
PORT=4000

# Must match the frontend's dev server origin exactly (scheme + host + port,
# no trailing slash) — e.g. your Codespaces port-5173 forwarded URL.
CORS_ORIGIN=http://localhost:5173

# Session cookie settings. Defaults below are correct for GitHub
# Codespaces (frontend and backend on different HTTPS subdomains —
# a cross-site setup that requires sameSite=none + secure=true).
# If you're instead running BOTH frontend and backend on plain
# http://localhost on your own machine (no Codespaces), set:
#   SESSION_COOKIE_SECURE=false
#   SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=none

# Used only by prisma/seed.ts to create the first Admin login.
SEED_ADMIN_EMPLOYEE_ID=ADMIN001
SEED_ADMIN_PASSWORD=ChangeMe123!
